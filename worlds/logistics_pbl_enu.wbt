DEF MOBILE_ROBOT Robot {
  # The robot starts in the lower-left green area, facing north (+Y).
  translation -0.725 -0.400 0.0
  rotation 0 0 1 1.5708
  children [
    Pose {
      translation 0 0 0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.28 0.95
            roughness 0.45
            metalness 0
          }
          geometry Box {
            size 0.15 0.105 0.045
          }
        }
      ]
    }
    Pose {
      translation 0.044 0 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.96 0.96 0.96
            roughness 0.4
            metalness 0
          }
          geometry Box {
            size 0.055 0.07 0.012
          }
        }
      ]
    }
    Pose {
      translation 0.087 0 0.04
      rotation 0 1 0 1.5708
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.12 0.08
            roughness 0.2
          }
          geometry Cylinder {
            height 0.012
            radius 0.014
          }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        position -8.698428839425077e-12
        axis 0 1 0
        anchor 0 0.064 0.022
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 16
          maxTorque 3
        }
        PositionSensor {
          name "left wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.064 0.022
        rotation 1 -4.349198444185277e-12 4.349214419712539e-12 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.03 0.03 0.03
              roughness 0.5
              metalness 0
            }
            geometry Cylinder {
              height 0.014
              radius 0.022
            }
          }
        ]
        name "left_wheel_solid"
        boundingObject Cylinder {
          height 0.014
          radius 0.022
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        position -8.694378550444526e-12
        axis 0 1 0
        anchor 0 -0.064 0.022
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 16
          maxTorque 3
        }
        PositionSensor {
          name "right wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.064 0.022
        rotation 1 -4.347173307133759e-12 4.347189275222263e-12 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.03 0.03 0.03
              roughness 0.5
              metalness 0
            }
            geometry Cylinder {
              height 0.014
              radius 0.022
            }
          }
        ]
        name "right_wheel_solid"
        boundingObject Cylinder {
          height 0.014
          radius 0.022
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    # Rear passive support: keeps the chassis from dropping behind the wheel axle.
    Pose {
      translation -0.055 0 0.013
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.06 0.06 0.06
            roughness 0.35
            metalness 0
          }
          geometry Sphere {
            radius 0.013
          }
        }
      ]
    }
    # Front passive support: fixes the previous nose-down/tilted motion.
    Pose {
      translation 0.065 0 0.013
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.06 0.06 0.06
            roughness 0.35
            metalness 0
          }
          geometry Sphere {
            radius 0.013
          }
        }
      ]
    }
    Emitter {
      name "magnet_emitter"
      channel 1
    }
    Receiver {
      name "task_receiver"
      channel 2
    }
  ]
  name "mobile_robot"
  boundingObject Group {
    children [
      Pose {
        translation 0 0 0.05
        children [
          Box {
            size 0.15 0.105 0.045
          }
        ]
      }
      Pose {
        translation -0.055 0 0.013
        children [
          Sphere {
            radius 0.013
          }
        ]
      }
      Pose {
        translation 0.065 0 0.013
        children [
          Sphere {
            radius 0.013
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.7
    # Fixed center of mass near the chassis center to reduce pitching/tilting.
    centerOfMass [
      0 0 0.040
    ]
  }
  controller "student_controller"
}
DEF CHALLENGE_SUPERVISOR Robot {
  children [
    Receiver {
      name "magnet_rx"
      channel 1
